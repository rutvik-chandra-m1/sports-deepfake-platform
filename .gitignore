# ===== Python / Backend =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== Node / Frontend =====
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Environment =====
.env
.env.local
backend/.env
frontend/.env

# ===== Database =====
database/*.db
database/*.db-shm
database/*.db-wal
database/*.sqlite3
database/*.sqlite3-journal

# ===== Media / Runtime Data =====
uploads/images/*
uploads/videos/*
!uploads/images/.gitkeep
!uploads/videos/.gitkeep
reports/*
!reports/.gitkeep
# Dataset audit reports ARE tracked: small JSON, and they are the evidence
# behind docs/dataset.md's confound claims. Per-analysis user reports
# (Milestone 13/R13 output) stay ignored.
!reports/dataset_audit*.json
# Evaluation results are the project's core evidence -- tracked deliberately.
!reports/evaluation/
!reports/evaluation/*.json
!reports/evaluation/*.csv
!reports/evaluation/*.png

# ===== AI Models (large binaries, fetched via download script) =====
models/pretrained/*
!models/pretrained/.gitkeep

# ===== R2 dataset (raw media fetched/generated by ml/data/*.py, not
# committed -- manifest/attribution *.csv files ARE tracked as the
# reproducible record; re-run the ml/data/*.py scripts to regenerate images) =====
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
# Derived cache: regenerated by ml/train/extract_embeddings.py from the
# images + the backbone model. Grows with the dataset, so tracking it would
# bloat history for no reproducibility gain -- the script is the record.
datasets/embeddings.npz

# ===== OS / Editor =====
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===== Docker =====
*.pid
# Alembic scratch DBs from local migration testing
backend/_alembic_baseline.db
backend/_eval_scratch.db
database/*.backup
database/*.pre-alembic-backup
