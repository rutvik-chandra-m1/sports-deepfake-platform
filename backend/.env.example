# Copy to backend/.env for local backend-only overrides.
# Falls back to root .env / defaults in config.py if unset.

APP_ENV=development
APP_NAME="Sports Deepfake Detection & Verification Platform"
APP_VERSION=0.1.0
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite:///../database/app.db

UPLOAD_DIR=../uploads
REPORTS_DIR=../reports
MODELS_DIR=../models/pretrained

MAX_UPLOAD_SIZE_MB=200
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv

LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ----- Security (R9) -- see docs/security.md -----
# Empty disables auth: fine for local development, REJECTED AT STARTUP when
# APP_ENV is not a development/test value, so "unset" can never silently mean
# "open to the internet" in production.
API_KEY=

# Only enable behind a genuinely trusted proxy -- X-Forwarded-For is
# client-settable, so trusting it otherwise lets anyone spoof their identity
# and bypass rate limiting.
TRUST_PROXY_HEADERS=false

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Uploads run the full detection pipeline, so they get a tighter budget.
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
MAX_PAGE_SIZE=200
