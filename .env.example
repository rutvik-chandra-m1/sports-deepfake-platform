# =========================================================
# Sports Deepfake Detection & Verification Platform
# Root Environment Template
# Copy this file to .env and adjust values as needed.
# Backend also has its own backend/.env.example (created in Milestone 2).
# =========================================================

# ----- General -----
APP_ENV=development
APP_NAME="Sports Deepfake Detection & Verification Platform"
APP_VERSION=0.1.0

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ----- Frontend -----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ----- Database -----
DATABASE_URL=sqlite:///./database/app.db

# ----- Storage -----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv

# ----- Models -----
MODELS_DIR=./models/pretrained

# ----- Security -----
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-in-production
