# Copy to `.env` next to docker-compose.yml, then fill in the two secrets.
# `docker compose up` fails fast with a readable message if either is empty.

# Shared API key clients must send as `X-API-Key`. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Server-side secret. Generate the same way; do NOT reuse API_KEY.
SECRET_KEY=

# Host port for the web UI.
WEB_PORT=8080

# Must match the address users actually type, including the port.
CORS_ORIGINS=http://localhost:8080

# Analyses run on a bounded thread pool. More workers than physical cores
# just thrashes -- the pipeline is CPU-bound.
MAX_CONCURRENT_ANALYSES=2

LOG_LEVEL=INFO
